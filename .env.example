# Database Configuration
POSTGRES_USER=thermocook
POSTGRES_PASSWORD=thermopassword
POSTGRES_DB=thermocook
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Backend Configuration
BACKEND_IMAGE=ghcr.io/nimpnaw/thermocook-backend:latest
BACKEND_PORT=8000
OUTPUT_DIR=/app/data/recipes
SECRET_KEY=change-me-in-production
# Origines autorisées pour CORS (séparées par des virgules)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Importation automatique des recettes locales au boot (true/false)
AUTO_IMPORT=true
# Cookie JWT Secure (HTTPS uniquement en production)
COOKIE_SECURE=false

# Frontend Configuration
FRONTEND_IMAGE=ghcr.io/nimpnaw/thermocook-frontend:latest
FRONTEND_PORT=3000

# Admin Account (recréé à chaque démarrage depuis ces variables)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
